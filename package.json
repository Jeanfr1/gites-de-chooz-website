{
  "name": "gites-de-chooz-website",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "So Dream — gîtes Le Grain d’Amour, La Brasserie, Chez Suzanne et Au Petit Bouchon, Chooz (Ardennes) — site en 7 langues",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-i18n.mjs && vite build",
