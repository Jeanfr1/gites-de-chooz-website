    "check:i18n": "node scripts/check-i18n.mjs"
  },
  "engines": {
    "node": ">=20.9"
  },
  "devDependencies": {
    "sharp": "^0.35.5",
    "vite": "^6.4.4"
  },
  "dependencies": {
    "@fontsource-variable/jost": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "gsap": "^3.13.0"
  }
